# 复制为 deployment.env 后修改；不能填写密钥内容。
IMMICH_URL=http://immich-server:2283
IMMICH_NETWORK=immich_default
BRIDGE_STATE_DIR=./state
IMMICH_API_KEY_PATH=./secrets/immich_api_key
WEBHOOK_SECRET_PATH=./secrets/webhook_secret
BRIDGE_MODE=observe
IMMICH_WRITE_ENABLED=false
ALLOWED_IMMICH_VERSIONS=3.4.0
HONOR_MODEL=AAK-AN00
RECORD_MAX_BYTES=16777216
RECORD_TIMEZONE=UTC
CLEANUP_GRACE_SECONDS=86400
WORKERS=1
UPLOAD_READY_TIMEOUT=180
REQUIRE_AUDIO=false
